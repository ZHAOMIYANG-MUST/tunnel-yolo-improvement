+# ===== WIoU v3 support (Tong et al., arXiv:2301.10051) =====
+# Enable via environment variable YOLO_IOU_TYPE=wiou ; default keeps original CIoU.
+import os as _os
+_IOU_TYPE = _os.getenv("YOLO_IOU_TYPE", "ciou").lower()
+_WIOU_ALPHA = float(_os.getenv("WIOU_ALPHA", "1.9"))
+_WIOU_DELTA = float(_os.getenv("WIOU_DELTA", "3.0"))
+_WIOU_MOMENTUM = float(_os.getenv("WIOU_MOMENTUM", "0.1"))
+
+
+def bbox_iou_wiou_v3(pred: torch.Tensor, target: torch.Tensor, iou_mean: torch.Tensor) -> torch.Tensor:
+    """Compute WIoU v3 loss for xyxy boxes (per-box, unweighted).
+
+    L = r * R_WIoU * L_IoU, where R_WIoU = exp(rho2/(cw^2+ch^2)) (normalizer detached),
+    beta = L_IoU / iou_mean (outlier degree, detached), r = beta / (delta * alpha^(beta-delta)).
+    """
+    eps = 1e-7
+    lt = torch.max(pred[:, :2], target[:, :2])
+    rb = torch.min(pred[:, 2:], target[:, 2:])
+    wh = (rb - lt).clamp(min=0)
+    inter = wh[:, 0] * wh[:, 1]
+    area1 = (pred[:, 2] - pred[:, 0]).clamp(min=0) * (pred[:, 3] - pred[:, 1]).clamp(min=0)
+    area2 = (target[:, 2] - target[:, 0]).clamp(min=0) * (target[:, 3] - target[:, 1]).clamp(min=0)
+    union = area1 + area2 - inter + eps
+    iou = inter / union  # gradient flows through pred
+
+    enc_lt = torch.min(pred[:, :2], target[:, :2])
+    enc_rb = torch.max(pred[:, 2:], target[:, 2:])
+    cw = (enc_rb[:, 0] - enc_lt[:, 0]).clamp(min=eps)
+    ch = (enc_rb[:, 1] - enc_lt[:, 1]).clamp(min=eps)
+    pcx, pcy = (pred[:, 0] + pred[:, 2]) / 2, (pred[:, 1] + pred[:, 3]) / 2
+    tcx, tcy = (target[:, 0] + target[:, 2]) / 2, (target[:, 1] + target[:, 3]) / 2
+    rho2 = (pcx - tcx) ** 2 + (pcy - tcy) ** 2
+
+    with torch.no_grad():
+        r_wiou = torch.exp(rho2 / (cw.detach() ** 2 + ch.detach() ** 2))  # R_WIoU
+        l_iou = 1.0 - iou
+        beta = l_iou / iou_mean.clamp(min=eps)  # outlier degree
+        focus = beta / (_WIOU_DELTA * _WIOU_ALPHA ** (beta - _WIOU_DELTA))  # r
+    return focus * r_wiou * l_iou
+
